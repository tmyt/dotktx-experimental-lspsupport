<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="artifacts/.packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="artifacts" />
    <add key="dotkt" value="https://dotkt.utatane.dev/nuget/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="DotKtx.Experimental.LspSupport" />
    </packageSource>
    <packageSource key="dotkt">
      <package pattern="DotKt.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
