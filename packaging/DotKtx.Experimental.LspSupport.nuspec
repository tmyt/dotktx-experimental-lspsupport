<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotKtx.Experimental.LspSupport</id>
    <version>$version$</version>
    <authors>DotKtx</authors>
    <license type="expression">Apache-2.0</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/tmyt/dotktx-experimental-lspsupport</projectUrl>
    <repository type="git" url="https://github.com/tmyt/dotktx-experimental-lspsupport.git" />
    <description>Experimental JetBrains Kotlin LSP workspace projection for DotKt projects. Projects the CLR reference KLIBs into a single analysis-only JAR whose classfiles carry the same kotlin.Metadata a compiled Kotlin library would, so the editor reads the CLR API as declared. The Kotlin standard library, including kotlin.clr, is projected from DotKt's own CLR standard library KLIB, so no JVM-only stdlib API reaches completion. Targets DotKt 0.9.13-beta2.</description>
    <tags>dotkt kotlin clr lsp vscode experimental</tags>
  </metadata>
  <files>
    <file src="../README.md" target="README.md" />
    <file src="../LICENSE" target="LICENSE" />
    <file src="../THIRD-PARTY-NOTICES.md" target="THIRD-PARTY-NOTICES.md" />
    <file src="build/**" target="build" />
    <file src="../src/DotKtx.Experimental.LspSupport/bin/$configuration$/net10.0/**" target="tools/net10.0/any" />
  </files>
</package>
