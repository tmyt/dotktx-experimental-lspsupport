<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotKtx.Experimental.LspSupport</id>
    <version>$version$</version>
    <authors>DotKtx</authors>
    <license type="expression">Apache-2.0</license>
    <readme>README.md</readme>
    <description>Experimental JetBrains Kotlin LSP workspace projection for DotKt projects. Models the Kotlin standard library with an analysis-only JVM JAR, overlays DotKt-specific kotlin.clr declarations, and generates Kotlin sources from CLR reference KLIBs.</description>
    <tags>dotkt kotlin clr lsp vscode experimental</tags>
  </metadata>
  <files>
    <file src="../README.md" target="README.md" />
    <file src="../LICENSE" target="LICENSE" />
    <file src="../THIRD-PARTY-NOTICES.md" target="THIRD-PARTY-NOTICES.md" />
    <file src="build/**" target="build" />
    <file src="../src/DotKtx.Experimental.LspSupport/bin/$configuration$/net10.0/**" target="tools/net10.0/any" />
  </files>
</package>
