<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DotKtx.Experimental.LspSupport</AssemblyName>
    <RootNamespace>DotKtx.Experimental.LspSupport</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
    <!-- Build-time compiler host only. Its package layout is consumed here while producing this
         experimental package; projects using LspSupport never observe or resolve this path. -->
    <PackageReference Include="DotKt.Toolchain"
                      Version="$(DotKtVersion)"
                      GeneratePathProperty="true"
                      PrivateAssets="all"
                      ExcludeAssets="all" />
    <Protobuf Include="KlibMetadata.proto" GrpcServices="None" />
    <Protobuf Include="JvmMetadata.proto" GrpcServices="None" />
    <!-- The emitted kotlin.Metadata version has to track the Kotlin release whose stdlib this package
         ships, so it is carried from the single property that pins it rather than duplicated in code. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DotKtKotlinVersion</_Parameter1>
      <_Parameter2>$(DotKtKotlinVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The only thing still taken from the JVM distribution is the Kotlin builtins: `Any`, `Int`,
       `List` and the rest of the core classifier set, which the analyzer reads from resources rather
       than classfiles and which the JVM maps onto java.lang types. Unit.class and Function.class are the ABI bridges:
       the JVM analyzer needs Unit for callback type arguments and Function as the superclass of FunctionN.
       Everything else - including
       kotlin.clr - is projected from DotKt's own CLR standard library KLIB at project build time, so
       no JVM-only stdlib API can reach completion. This is not a DotKt compiler input. -->
  <Target Name="BuildDotKtLspBuiltins"
          AfterTargets="Build"
          Inputs="$(MSBuildProjectFullPath);$(PkgDotKt_Toolchain)/tools/kotc/lib/kotlin-stdlib-$(DotKtKotlinVersion).jar"
          Outputs="$(TargetDir)kotlin-builtins.jar">
    <PropertyGroup>
      <_DotKtJvmStdlib>$(PkgDotKt_Toolchain)/tools/kotc/lib/kotlin-stdlib-$(DotKtKotlinVersion).jar</_DotKtJvmStdlib>
      <_DotKtBuiltinsStaging>$(IntermediateOutputPath)kotlin-builtins/</_DotKtBuiltinsStaging>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DotKtJvmStdlib)')"
           Text="DotKt.Toolchain $(DotKtVersion) does not contain Kotlin stdlib $(DotKtKotlinVersion)." />
    <RemoveDir Directories="$(_DotKtBuiltinsStaging)" />
    <Unzip SourceFiles="$(_DotKtJvmStdlib)" DestinationFolder="$(_DotKtBuiltinsStaging)" />
    <ItemGroup>
      <_DotKtBuiltinsKeep Include="$(_DotKtBuiltinsStaging)**/*.kotlin_builtins" />
      <_DotKtBuiltinsKeep Include="$(_DotKtBuiltinsStaging)kotlin/Unit.class" />
      <_DotKtBuiltinsKeep Include="$(_DotKtBuiltinsStaging)kotlin/Function.class" />
      <_DotKtBuiltinsDrop Include="$(_DotKtBuiltinsStaging)**/*" Exclude="@(_DotKtBuiltinsKeep)" />
    </ItemGroup>
    <Error Condition="'@(_DotKtBuiltinsKeep->Count())' == '0'"
           Text="Kotlin stdlib $(DotKtKotlinVersion) contains no *.kotlin_builtins resources." />
    <Delete Files="@(_DotKtBuiltinsDrop)" />
    <ZipDirectory SourceDirectory="$(_DotKtBuiltinsStaging)"
                  DestinationFile="$(TargetDir)kotlin-builtins.jar"
                  Overwrite="true" />
  </Target>

</Project>
